###==== BEGIN Clocks
create_clock -name {sys_clk} [get_ports {sys_clk}] -period {20.000} -waveform {0.000 10.000}
# OV5640 is programmed for a 48 MHz DVP PCLK (0x3035=0x11,
# 0x3036=0x3c, 0x4837=0x22), so constrain all camera inputs accordingly.
create_clock -name {cam_pclk_1} [get_ports cam_pclk_1] -period {20.833333} -waveform {0.000000 10.416667}
create_clock -name {cam_pclk_2} [get_ports cam_pclk_2] -period {20.833333} -waveform {0.000000 10.416667}
create_clock -name {cam_pclk_3} [get_ports cam_pclk_3] -period {20.833333} -waveform {0.000000 10.416667}

# ADV7611 720p60恢复像素时钟。
create_clock -name {hdmi_input_clk} [get_ports hdmi_clk_in] -period {13.468013} -waveform {0.000000 6.734006}
# 千兆RGMII接收时钟，PHY在1Gbps模式下输出125MHz。
create_clock -name {eth_rxc} [get_ports eth_rxc] -period {8.000} -waveform {0.000 4.000}
create_clock -name {eth1_rxc} [get_ports eth1_rxc] -period {8.000} -waveform {0.000 4.000}

# HDMI发送时钟由ADV7611恢复像素时钟同源生成，不会与输入视频产生长期频偏。
# PLL配置中1倍输出相移180度，5倍输出相移36度；显式描述边沿以约束源同步直通路径。
create_generated_clock -name {pixel_clk} -source [get_ports {hdmi_clk_in}] [get_pins {u_hdmi_video_pll/clkout0}] -master_clock [get_clocks {hdmi_input_clk}] -edges {1 2 3} -edge_shift {6.734006 6.734006 6.734006}
create_generated_clock -name {pixel_clk_5x} -source [get_ports {hdmi_clk_in}] [get_pins {u_hdmi_video_pll/clkout1}] -master_clock [get_clocks {hdmi_input_clk}] -edges {1 2 3} -edge_shift {1.346801 -4.040404 -9.427609}

###==== END Clocks

###==== BEGIN "Generated Clocks"
create_generated_clock -name {rst_clk} -source [get_ports {sys_clk}] [get_pins {u_ddr3_ctrl_top.u_ddr3_ip.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {sys_clk}] -multiply_by {32} -divide_by {32}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {sys_clk}] [get_pins {u_ddr3_ctrl_top.u_ddr3_ip.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {sys_clk}] -multiply_by {32} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {sys_clk}] [get_pins {u_ddr3_ctrl_top.u_ddr3_ip.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {sys_clk}] -multiply_by {32} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {u_ddr3_ctrl_top.u_ddr3_ip.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr3_ctrl_top.u_ddr3_ip.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {sys_clk}] [get_pins {u_ddr3_ctrl_top.u_ddr3_ip.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {sys_clk}] -multiply_by {32} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {u_ddr3_ctrl_top.u_ddr3_ip.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr3_ctrl_top.u_ddr3_ip.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold

# 三路OV5640 SCCB控制器由50 MHz系统时钟分频得到1 MHz内部驱动时钟。
# 显式约束后，I2C状态机也会纳入静态时序分析。
create_generated_clock -name {cam_i2c_clk_1} -source [get_ports {sys_clk}] [get_pins {u_ov5640_dri_1.u_i2c_dri/dri_clk}] -master_clock [get_clocks {sys_clk}] -divide_by {50}
create_generated_clock -name {cam_i2c_clk_2} -source [get_ports {sys_clk}] [get_pins {u_ov5640_dri_2.u_i2c_dri/dri_clk}] -master_clock [get_clocks {sys_clk}] -divide_by {50}
create_generated_clock -name {cam_i2c_clk_3} -source [get_ports {sys_clk}] [get_pins {u_ov5640_dri_3.u_i2c_dri/dri_clk}] -master_clock [get_clocks {sys_clk}] -divide_by {50}

# 摄像头、DDR/PHY、HDMI和以太网是独立时钟域；HDMI输入及其PLL输出属于同一组相关时钟。
# 异步域之间只通过异步FIFO或双触发同步器传输。
set_clock_groups -name user_clock_domains -asynchronous \
    -group [get_clocks {sys_clk rst_clk ddrphy_sysclk phy_dq_clk_0 phy_dq_sysclk_0 phy_dq_clk_1 phy_dq_sysclk_1}] \
    -group [get_clocks {hdmi_input_clk pixel_clk pixel_clk_5x}] \
    -group [get_clocks {cam_pclk_1}] \
    -group [get_clocks {cam_pclk_2}] \
    -group [get_clocks {cam_pclk_3}] \
    -group [get_clocks {eth_rxc}] \
    -group [get_clocks {eth1_rxc}]
set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]

###==== BEGIN set_clock_uncertainty"
#set_clock_uncertainty {0.200} [get_clocks {ui_clk}]  -setup -hold
###==== END "set_clock_group"

###==== BEGIN Attributes

