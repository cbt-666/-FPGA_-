# 超声波模块使用J3空闲3.3 V IO；echo为输入，trig为输出。
define_attribute {p:ultrasonic_echo} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:ultrasonic_echo} {PAP_IO_LOC} {D16}
define_attribute {p:ultrasonic_echo} {PAP_IO_VCCIO} {3.3}
define_attribute {p:ultrasonic_echo} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:ultrasonic_echo} {PAP_IO_NONE} {TRUE}
define_attribute {p:ultrasonic_trig} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:ultrasonic_trig} {PAP_IO_LOC} {E16}
define_attribute {p:ultrasonic_trig} {PAP_IO_VCCIO} {3.3}
define_attribute {p:ultrasonic_trig} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:ultrasonic_trig} {PAP_IO_DRIVE} {4}
define_attribute {p:ultrasonic_trig} {PAP_IO_SLEW} {SLOW}
define_attribute {p:ultrasonic_trig} {PAP_IO_NONE} {TRUE}
define_attribute {p:led0} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led0} {PAP_IO_LOC} {V9}
define_attribute {p:led0} {PAP_IO_VCCIO} {1.5}
define_attribute {p:led0} {PAP_IO_STANDARD} {LVCMOS15}
define_attribute {p:led0} {PAP_IO_DRIVE} {4}
define_attribute {p:led0} {PAP_IO_NONE} {TRUE}
